+namespace {
+uint64_t Now() {
+  return static_cast<uint64_t>(g_get_monotonic_time()) * 1000;
+}
+// Restore the caller's EGL state, including its bound client API. GDK caches
+// its current context, so changing EGL state without restoring it is unsafe.
+class EGLScope {
+ public:
+  EGLScope()
+      : display_(eglGetCurrentDisplay()),
+        context_(eglGetCurrentContext()),
+        draw_(eglGetCurrentSurface(EGL_DRAW)),
+        read_(eglGetCurrentSurface(EGL_READ)),
+        api_(eglQueryAPI()) {}
+  ~EGLScope() {
+    EGLDisplay current = eglGetCurrentDisplay();
+    if (display_ != EGL_NO_DISPLAY) {
+      eglMakeCurrent(display_, draw_, read_, context_);
+    } else if (current != EGL_NO_DISPLAY) {
+      eglMakeCurrent(current, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+    eglBindAPI(api_);
+  }
+
+ private:
+  EGLDisplay display_;
+  EGLContext context_;
+  EGLSurface draw_, read_;
+  EGLenum api_;
+};
+}  // namespace
+
+FlWaylandSurface* FlWaylandSurface::Create(GtkWidget* widget,
+                                           GdkGLContext* context) {
+  if (g_strcmp0(g_getenv("FLUTTER_LINUX_DISABLE_WAYLAND_FRAME_SYNC"), "1") ==
+          0 ||
+      !GDK_IS_WAYLAND_DISPLAY(gtk_widget_get_display(widget)))
+    return nullptr;
+  auto* self = new FlWaylandSurface(widget);
+  if (!self->Initialize(context)) {
+    delete self;
+    g_warning("Wayland frame surface unavailable; using GTK rendering");
+    return nullptr;
+  }
+  return self;
+}
+
+void FlWaylandSurface::Global(void* data,
+                              wl_registry* registry,
+                              uint32_t name,
+                              const char* interface,
+                              uint32_t version) {
+  auto* self = static_cast<FlWaylandSurface*>(data);
+  if (strcmp(interface, wl_compositor_interface.name) == 0 && version >= 3) {
+    self->compositor_ = static_cast<wl_compositor*>(
+        wl_registry_bind(registry, name, &wl_compositor_interface, 3));
+  } else if (strcmp(interface, wp_presentation_interface.name) == 0) {
+    self->presentation_ = static_cast<wp_presentation*>(
+        wl_registry_bind(registry, name, &wp_presentation_interface, 1));
+    static const wp_presentation_listener listener = {ClockID};
+    wp_presentation_add_listener(self->presentation_, &listener, self);
+  } else if (strcmp(interface, wl_subcompositor_interface.name) == 0) {
+    self->subcompositor_ = static_cast<wl_subcompositor*>(
+        wl_registry_bind(registry, name, &wl_subcompositor_interface, 1));
+  }
+}
+
+bool FlWaylandSurface::Initialize(GdkGLContext* gdk_context) {
+  GdkWindow* parent = gtk_widget_get_window(gtk_widget_get_toplevel(widget_));
+  if (!parent)
+    return false;
+  wl_surface* parent_surface = gdk_wayland_window_get_wl_surface(parent);
+  if (!parent_surface)
+    return false;
+  display_ =
+      gdk_wayland_display_get_wl_display(gtk_widget_get_display(widget_));
+
+  // Registry discovery uses a private queue so realization cannot re-enter GTK
+  // via an unrelated configure event. Live surfaces use GDK's default queue.
+  wl_event_queue* queue = wl_display_create_queue(display_);
+  wl_registry* registry = wl_display_get_registry(display_);
+  wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(registry), queue);
+  static const wl_registry_listener listener = {Global, GlobalRemove};
+  wl_registry_add_listener(registry, &listener, this);
+  int result = wl_display_roundtrip_queue(display_, queue);
+  if (compositor_)
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(compositor_), nullptr);
+  if (subcompositor_)
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(subcompositor_), nullptr);
+  if (presentation_)
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(presentation_), nullptr);
+  wl_registry_destroy(registry);
+  wl_event_queue_destroy(queue);
+  if (result < 0 || !compositor_ || !subcompositor_)
+    return false;
+
+  surface_ = wl_compositor_create_surface(compositor_);
+  subsurface_ =
+      wl_subcompositor_get_subsurface(subcompositor_, surface_, parent_surface);
+  wl_subsurface_set_desync(subsurface_);
+  wl_region* empty = wl_compositor_create_region(compositor_);
+  wl_surface_set_input_region(surface_, empty);
+  wl_region_destroy(empty);
+
+  gdk_gl_context_make_current(gdk_context);
+  EGLScope scope;
+  egl_display_ = eglGetCurrentDisplay();
+  EGLContext current = eglGetCurrentContext();
+  if (egl_display_ == EGL_NO_DISPLAY || current == EGL_NO_CONTEXT)
+    return false;
+  EGLint api = EGL_OPENGL_API;
+  eglQueryContext(egl_display_, current, EGL_CONTEXT_CLIENT_TYPE, &api);
+  EGLint config_attributes[] = {
+      EGL_SURFACE_TYPE,
+      EGL_WINDOW_BIT,
+      EGL_RED_SIZE,
+      8,
+      EGL_GREEN_SIZE,
+      8,
+      EGL_BLUE_SIZE,
+      8,
+      EGL_ALPHA_SIZE,
+      8,
+      EGL_RENDERABLE_TYPE,
+      api == EGL_OPENGL_API ? EGL_OPENGL_BIT : EGL_OPENGL_ES3_BIT,
+      EGL_NONE};
+  EGLConfig config = nullptr;
+  EGLint count = 0;
+  if (!eglChooseConfig(egl_display_, config_attributes, &config, 1, &count) ||
+      !count)
+    return false;
+  eglBindAPI(api);
+  const EGLint gl_attributes[] = {EGL_CONTEXT_MAJOR_VERSION,
+                                  3,
+                                  EGL_CONTEXT_MINOR_VERSION,
+                                  2,
+                                  EGL_CONTEXT_OPENGL_PROFILE_MASK,
+                                  EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+                                  EGL_NONE};
+  const EGLint es_attributes[] = {EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE};
+  context_ =
+      eglCreateContext(egl_display_, config, EGL_NO_CONTEXT,
+                       api == EGL_OPENGL_API ? gl_attributes : es_attributes);
+  if (context_ == EGL_NO_CONTEXT)
+    return false;
+  window_ = wl_egl_window_create(surface_, 1, 1);
+  egl_surface_ = eglCreateWindowSurface(
+      egl_display_, config, reinterpret_cast<EGLNativeWindowType>(window_),
+      nullptr);
+  if (egl_surface_ == EGL_NO_SURFACE)
+    return false;
+  if (!eglMakeCurrent(egl_display_, egl_surface_, egl_surface_, context_))
+    return false;
+  // Rendering is paced by compositor frame callbacks. Never block the GTK/UI
+  // thread in swap waiting for another refresh.
+  eglSwapInterval(egl_display_, 0);
+  if (const char* path = g_getenv("FLUTTER_LINUX_FRAME_TIMINGS")) {
+    static bool trace_started = false;
+    trace_ = fopen(path, trace_started ? "a" : "w");
+    if (trace_) {
+      if (!trace_started)
+        fprintf(trace_, "event,time_ns,refresh_ns,flags\n");
+      trace_started = true;
+    }
+  }
+  return true;
+}
+
+FlWaylandSurface::~FlWaylandSurface() {
+  CancelVsync();
+  for (auto* feedback : feedbacks_)
+    wp_presentation_feedback_destroy(feedback);
+  if (presentation_)
+    wp_presentation_destroy(presentation_);
+  if (trace_)
+    fclose(trace_);
+  if (egl_surface_ != EGL_NO_SURFACE)
+    eglDestroySurface(egl_display_, egl_surface_);
+  if (context_ != EGL_NO_CONTEXT)
+    eglDestroyContext(egl_display_, context_);
+  if (window_)
+    wl_egl_window_destroy(window_);
+  if (subsurface_)
+    wl_subsurface_destroy(subsurface_);
+  if (surface_)
+    wl_surface_destroy(surface_);
+  if (subcompositor_)
+    wl_subcompositor_destroy(subcompositor_);
+  if (compositor_)
+    wl_compositor_destroy(compositor_);
+}
+
+uint64_t FlWaylandSurface::Interval() const {
+  GdkWindow* window = gtk_widget_get_window(widget_);
+  GdkMonitor* monitor = window ? gdk_display_get_monitor_at_window(
+                                     gtk_widget_get_display(widget_), window)
+                               : nullptr;
+  int rate = monitor ? gdk_monitor_get_refresh_rate(monitor) : 0;
+  return rate > 0 ? 1000000000000ULL / rate : 16666667;
+}
+
+bool FlWaylandSurface::Present(FlCompositorOpenGL* compositor) {
+  if (!gtk_widget_get_mapped(widget_))
+    return true;
+  GtkAllocation allocation;
+  gtk_widget_get_allocation(widget_, &allocation);
+  int scale = gtk_widget_get_scale_factor(widget_);
+  int width = allocation.width * scale;
+  int height = allocation.height * scale;
+  if (width <= 0 || height <= 0)
+    return true;
+  int x = 0, y = 0;
+  gtk_widget_translate_coordinates(widget_, gtk_widget_get_toplevel(widget_), 0,
+                                   0, &x, &y);
+  wl_subsurface_set_position(subsurface_, x, y);
+  wl_surface_set_buffer_scale(surface_, scale);
+  wl_egl_window_resize(window_, width, height, 0, 0);
+  EGLScope scope;
+  if (!eglMakeCurrent(egl_display_, egl_surface_, egl_surface_, context_))
+    return false;
+  if (!fl_compositor_opengl_blit(compositor, width, height))
+    return true;
+  if (!pending_.empty())
+    ArmFrame();
+  if (presentation_) {
+    auto* feedback = wp_presentation_feedback(presentation_, surface_);
+    static const wp_presentation_feedback_listener listener = {
+        FeedbackOutput, FeedbackPresented, FeedbackDiscarded};
+    wp_presentation_feedback_add_listener(feedback, &listener, this);
+    feedbacks_.push_back(feedback);
+  }
+  if (!eglSwapBuffers(egl_display_, egl_surface_))
+    return false;
+  if (trace_)
+    fprintf(trace_, "submit,%llu,%llu,0\n",
+            static_cast<unsigned long long>(Now()),
+            static_cast<unsigned long long>(Interval()));
+  has_buffer_ = true;
+  has_presented_ = true;
+  return true;
+}
+
+void FlWaylandSurface::ArmFrame() {
+  if (frame_)
+    return;
+  frame_ = wl_surface_frame(surface_);
+  static const wl_callback_listener listener = {FrameDone};
+  wl_callback_add_listener(frame_, &listener, this);
+}
+
+void FlWaylandSurface::RequestVsync(Vsync callback) {
+  pending_.push_back(std::move(callback));
+  // Bootstrap before the runner shows its window; hidden windows get a bounded
+  // wakeup so lifecycle/resize work and outstanding batons cannot deadlock.
+  if (!has_buffer_ || !gtk_widget_get_mapped(widget_)) {
+    if (!timeout_)
+      timeout_ = g_timeout_add(
+          !gtk_widget_get_mapped(widget_) && has_presented_ ? 250 : 16, Timeout,
+          this);
+    return;
+  }
+  ArmFrame();
+  wl_surface_commit(surface_);
+  wl_display_flush(display_);
+  if (!timeout_)
+    timeout_ = g_timeout_add(250, Timeout, this);
+}
+
+void FlWaylandSurface::FrameDone(void* data,
+                                 wl_callback* callback,
+                                 uint32_t time) {
+  auto* self = static_cast<FlWaylandSurface*>(data);
+  wl_callback_destroy(callback);
+  self->frame_ = nullptr;
+  if (self->timeout_) {
+    g_source_remove(self->timeout_);
+    self->timeout_ = 0;
+  }
+  uint64_t now = Now();
+  // wl_surface.frame has a millisecond clock with an unspecified epoch. Keep
+  // relative compositor timestamps (including uint32 wraparound), not variable
+  // callback arrival delays, as the animation timebase. Rebase after a pause.
+  uint32_t delta = time - self->last_time_;
+  if (!self->have_time_ || delta > 1000) {
+    self->frame_time_ = now;
+    self->have_time_ = true;
+  } else {
+    self->frame_time_ =
+        std::min(now, self->frame_time_ + uint64_t(delta) * 1000000);
+  }
+  if (self->monotonic_presentation_ && self->last_presentation_ &&
+      now >= self->last_presentation_ &&
+      now - self->last_presentation_ < 1000000000) {
+    uint64_t interval = self->Interval();
+    self->frame_time_ =
+        self->last_presentation_ +
+        ((now - self->last_presentation_) / interval) * interval;
+  }
+  self->last_time_ = time;
+  self->Complete(self->frame_time_);
+}
+
+gboolean FlWaylandSurface::Timeout(gpointer data) {
+  auto* self = static_cast<FlWaylandSurface*>(data);
+  self->timeout_ = 0;
+  if (self->frame_) {
+    wl_callback_destroy(self->frame_);
+    self->frame_ = nullptr;
+  }
+  self->have_time_ = false;
+  self->Complete(Now());
+  return G_SOURCE_REMOVE;
+}
+
+void FlWaylandSurface::Complete(uint64_t start) {
+  auto pending = std::move(pending_);
+  pending_.clear();
+  // Bootstrap and compositor clocks can overlap when mapping a window. Never
+  // let that handoff move the animation timeline backwards.
+  start = std::max(start, last_start_);
+  last_start_ = start;
+  uint64_t target = start + Interval();
+  for (auto& callback : pending)
+    callback(start, target);
+}
+
+void FlWaylandSurface::CancelVsync() {
+  if (timeout_) {
+    g_source_remove(timeout_);
+    timeout_ = 0;
+  }
+  if (frame_) {
+    wl_callback_destroy(frame_);
+    frame_ = nullptr;
+  }
+  have_time_ = false;
+  last_presentation_ = 0;
+  Complete(Now());
+}
+
+void FlWaylandSurface::ClockID(void* data, wp_presentation*, uint32_t clock) {
+  static_cast<FlWaylandSurface*>(data)->monotonic_presentation_ =
+      clock == CLOCK_MONOTONIC;
+}
+
+void FlWaylandSurface::RemoveFeedback(
+    struct wp_presentation_feedback* feedback) {
+  feedbacks_.erase(std::remove(feedbacks_.begin(), feedbacks_.end(), feedback),
+                   feedbacks_.end());
+  wp_presentation_feedback_destroy(feedback);
+}
+
+void FlWaylandSurface::FeedbackPresented(
+    void* data,
+    struct wp_presentation_feedback* feedback,
+    uint32_t hi,
+    uint32_t lo,
+    uint32_t nanos,
+    uint32_t refresh,
+    uint32_t sequence_hi,
+    uint32_t sequence_lo,
+    uint32_t flags) {
+  auto* self = static_cast<FlWaylandSurface*>(data);
+  self->last_presentation_ = ((uint64_t(hi) << 32) | lo) * 1000000000 + nanos;
+  if (self->trace_)
+    fprintf(self->trace_, "presented,%llu,%u,%u\n",
+            static_cast<unsigned long long>(self->last_presentation_), refresh,
+            flags);
+  self->RemoveFeedback(feedback);
+}
+
+void FlWaylandSurface::FeedbackDiscarded(
+    void* data,
+    struct wp_presentation_feedback* feedback) {
+  auto* self = static_cast<FlWaylandSurface*>(data);
+  if (self->trace_)
+    fprintf(self->trace_, "discarded,%llu,0,0\n",
+            static_cast<unsigned long long>(Now()));
+  self->RemoveFeedback(feedback);
+}
