+// The engine may request vsync on its UI thread. Resolve the window and talk
+// to Wayland only on the GTK thread. This transient reference protects engine
+// initialization/shutdown until the request has been dispatched.
+static void fl_engine_vsync_cb(void* user_data, intptr_t baton) {
+  struct Request {
+    FlEngine* engine;
+    intptr_t baton;
+  };
+  auto* request = new Request{FL_ENGINE(g_object_ref(user_data)), baton};
+  g_idle_add_full(
+      G_PRIORITY_DEFAULT,
+      [](gpointer data) -> gboolean {
+        auto* request = static_cast<Request*>(data);
+        FlEngine* self = request->engine;
+        g_autoptr(FlRenderable) view =
+            get_renderable(self, flutter::kFlutterImplicitViewId);
+        if (!view || !fl_renderable_request_vsync(view, request->baton)) {
+          // Headless, X11 and the first frame retain a bounded bootstrap path.
+          // VsyncWaiterEmbedder waits until this future timestamp internally.
+          uint64_t now = self->embedder_api.GetCurrentTime();
+          constexpr uint64_t interval = 16666667;
+          uint64_t start = ((now / interval) + 1) * interval;
+          fl_engine_on_vsync(self, request->baton, start, start + interval);
+        }
+        return G_SOURCE_REMOVE;
+      },
+      request,
+      [](gpointer data) {
+        auto* request = static_cast<Request*>(data);
+        g_object_unref(request->engine);
+        delete request;
+      });
+}
+
+void fl_engine_on_vsync(FlEngine* self,
+                        intptr_t baton,
+                        uint64_t frame_start,
+                        uint64_t frame_target) {
+  if (self->engine &&
+      self->embedder_api.OnVsync(self->engine, baton, frame_start,
+                                 frame_target) != kSuccess) {
+    g_warning("Failed to notify Flutter vsync");
+  }
+}
