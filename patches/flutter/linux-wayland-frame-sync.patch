+
+// An independently committed child surface. GTK keeps ownership of input and
+// window management; Flutter frames do not pass through GTK's repaint timer.
+// All methods and Wayland callbacks run on the GTK/platform thread.
+class FlWaylandSurface {
+ public:
+  using Vsync = std::function<void(uint64_t, uint64_t)>;
+  static FlWaylandSurface* Create(GtkWidget* widget, GdkGLContext* context);
+  ~FlWaylandSurface();
+  bool Present(FlCompositorOpenGL* compositor);
+  void RequestVsync(Vsync callback);
+  void CancelVsync();
+
+ private:
+  explicit FlWaylandSurface(GtkWidget* widget) : widget_(widget) {}
+  bool Initialize(GdkGLContext* context);
+  uint64_t Interval() const;
+  void ArmFrame();
+  void Complete(uint64_t start);
+  static void FrameDone(void* data, wl_callback* callback, uint32_t time);
+  static gboolean Timeout(gpointer data);
+  static void Global(void* data,
+                     wl_registry* registry,
+                     uint32_t name,
+                     const char* interface,
+                     uint32_t version);
+  static void GlobalRemove(void*, wl_registry*, uint32_t) {}
+
+  static void ClockID(void* data, wp_presentation*, uint32_t clock);
+  static void FeedbackOutput(void*,
+                             struct wp_presentation_feedback*,
+                             wl_output*) {}
+  static void FeedbackPresented(void* data,
+                                struct wp_presentation_feedback* feedback,
+                                uint32_t seconds_hi,
+                                uint32_t seconds_lo,
+                                uint32_t nanos,
+                                uint32_t refresh,
+                                uint32_t sequence_hi,
+                                uint32_t sequence_lo,
+                                uint32_t flags);
+  static void FeedbackDiscarded(void* data,
+                                struct wp_presentation_feedback* feedback);
+  void RemoveFeedback(struct wp_presentation_feedback* feedback);
+  wp_presentation* presentation_ = nullptr;
+  std::vector<struct wp_presentation_feedback*> feedbacks_;
+  bool monotonic_presentation_ = false;
+  uint64_t last_presentation_ = 0;
+  FILE* trace_ = nullptr;
+
+  GtkWidget* widget_;  // Owner; destroyed before the widget is unrealized.
+  wl_display* display_ = nullptr;
+  wl_compositor* compositor_ = nullptr;
+  wl_subcompositor* subcompositor_ = nullptr;
+  wl_surface* surface_ = nullptr;
+  wl_subsurface* subsurface_ = nullptr;
+  wl_egl_window* window_ = nullptr;
+  wl_callback* frame_ = nullptr;
+  EGLDisplay egl_display_ = EGL_NO_DISPLAY;
+  EGLContext context_ = EGL_NO_CONTEXT;
+  EGLSurface egl_surface_ = EGL_NO_SURFACE;
+  guint timeout_ = 0;
+  bool has_buffer_ = false;
+  bool has_presented_ = false;
+  bool have_time_ = false;
+  uint32_t last_time_ = 0;
+  uint64_t frame_time_ = 0;
+  uint64_t last_start_ = 0;
+  std::vector<Vsync> pending_;
+};
+#endif
